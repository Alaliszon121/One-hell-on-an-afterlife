      propertyPath: 'dialogueLines.Array.data[0]'
      value: "LOVER: Oh\u2026 Your stake holds are SO big\u2026 Mmmm\u2026 Call me
        a bad girl!"
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "LOVER: Hehe\u2026 You are such a bad team player. So unattentive to
        your colleagues\u2019 issues.  You don\u2019t prioritise company\u2019s interest
        enough."
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
