--- !u!1001 &1413721189
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 624573747}
    m_Modifications:
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "INTERN1: Hey, hey, you. Mind reviewing lyrics for the next PR musical
        spot? It goes like\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: 'INTERN: We treat our employees super nicely / And to buy our products
        would be wisely.'
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: "INTERN: Oh, and there\u2019s the chorus-!"
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: 'INTERN: Happy, well-paid hands build quality precisely / And Bestle
        SA definitely does not benefit from child labor or price-fixing cartels in
        West Africa contrary to what multiple human rights organisations try to prove. '
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: "INTERN: I\u2019m still working on a rhyme to the word \u201Cprove\u201D."
      objectReference: {fileID: 0}
    - target: {fileID: 6356091009939785067, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: m_LocalPosition.x
      value: -0.53
      objectReference: {fileID: 0}
