    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "WORKER: It\u2019s day 2137 of this office integration, dude. Day 2137
        of listening our boss talking about this Lisa chick."
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "WORKER: And you know what\u2019s even worse?"
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: "WORKER: There\u2019s no snacks. Fruit only. And the only ones left
        are soft melon pieces."
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: "WORKER: This isn\u2019t the afterlife I was promised. I want out. I
        want to see my late friends. I want this shitshow to end. I want to eat some
        actual snacks."
      objectReference: {fileID: 0}
