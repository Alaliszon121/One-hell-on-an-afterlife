      propertyPath: m_LocalPosition.z
      value: -13.8
      objectReference: {fileID: 0}
    - target: {fileID: 6934795082088813204, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: m_Name
      value: NPC_Intern1
      objectReference: {fileID: 0}
    - target: {fileID: 7367596236900740225, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
