--- !u!1001 &547932396
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1989574553}
    m_Modifications:
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: 'WORKER: This office buddy of mine keeps showing me weird political
        memes.'
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "WORKER: I don\u2019t think onboarding is supposed to last eternity."
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: 'WORKER: No clue what sins did I commit to deserve it, but I am so sorry.
        So, so sorry..'
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: "WORKER: This isn\u2019t the afterlife I was promised. I want out. I
        want to see my late friends. I want this shitshow to end. I want to eat some
        actual snacks."
      objectReference: {fileID: 0}
    - target: {fileID: 6356091009939785067, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
