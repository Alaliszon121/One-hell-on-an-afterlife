--- !u!1001 &1713884250
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 624573747}
    m_Modifications:
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "WORKER: I feel like I\u2019m roleplaying an accountant, dude. I type
        numbers that don\u2019t mean anything. Just\u2026 Fill in sheets day and
        night, over and over. Like a human cash register."
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "WORKER: \u2026What? Oh, no, no. I can\u2019t make them up and type
        anything. Are you crazy?"
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: 'WORKER: They do carry meaning. Just not one I get. Actually, once in
        a while I put in something wrong. Then, a manager yells at me and I have
        to start anew.'
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: "WORKER: I can\u2019t believe I ignored parties in college just to get
        hired here."
      objectReference: {fileID: 0}
    - target: {fileID: 6356091009939785067, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: m_LocalPosition.x
      value: -0.53
      objectReference: {fileID: 0}
