--- !u!1001 &1159554855
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 624573747}
    m_Modifications:
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "INTERN: Everyday they make us come up with a new spot to cover up company\u2019s
        another image crisis."
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "INTERN: Every. Single. Day. I\u2019m just a PR intern, I should be\u2026
        I don\u2019t know. Sweeping the floor. Making coffee."
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: "INTERN: I\u2019m starting to suspect the multi-billion company I work
        at for minimum wage is morally dubious."
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: 'INTERN: Their choco bars lowkey fire, though.'
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: 
      objectReference: {fileID: 0}
