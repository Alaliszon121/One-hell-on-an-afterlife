PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 624573747}
    m_Modifications:
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "CANDIDATE: \u2026Where do I see myself in the next five years\u2026?
        Uh\u2026 Still taking this job interview? Pretty sure five years have already
        passed."
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "CANDIDATE: Oh, hi. I\u2019m kinda busy."
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: 'CANDIDATE: What am I doing? Getting interviewed for a job, duh. Been
        interviewed for the past many, many days. Since I died, actually.'
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: "CANDIDATE: Between the two of us, I totally lied on my resume. I can\u2019t
        tell if they can tell."
      objectReference: {fileID: 0}
    - target: {fileID: 6356091009939785067, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
