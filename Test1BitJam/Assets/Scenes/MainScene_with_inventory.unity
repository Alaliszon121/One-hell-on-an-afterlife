    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "WORKER: Aren\u2019t our managers genuinely scary? They speak in tongues
        noone can understand."
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: 'WORKER: Deadlines, helicopter view, story points, yap, yap, yap.'
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: "WORKER: Whatever that means. Just don\u2019t get caught by them. You
        don\u2019t want to get accused of not being proactive enough"
      objectReference: {fileID: 0}
