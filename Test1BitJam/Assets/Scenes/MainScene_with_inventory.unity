      propertyPath: 'dialogueLines.Array.data[0]'
      value: "STALL USER: H-hey, don\u2019t walk so loud, they\u2019ll hear you?. "
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "STALL USER: The stall beside? It\u2019s my scrum master and her secretary.
        Eugh. I\u2019m waiting for them to finally finish and leave so I can poop
        in peace."
      objectReference: {fileID: 0}
    - target: {fileID: 3541254465169737056, guid: 9c78360f7f5f9314fbf37e04c8dd6404, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: "STALL USER: Lord above, I shouldn\u2019t have drunk that much office
        cofffee\u2026 Ugh, my stomach\u2026"
      objectReference: {fileID: 0}
