  dialogueCanvas: {fileID: 930405582}
  dialogueText: {fileID: 1473751727}
  dialogueLines:
  - "WORKER: It\u2019s day 2137 of this office integration, dude. Day 2137 of listening
    our boss talking about this Lisa chick."
  - "WORKER: And you know what\u2019s even worse?"
  - "WORKER: There\u2019s no snacks. Fruit only. And the only ones left are soft
    melon pieces."
  - "WORKER: This isn\u2019t the afterlife I was promised. I want out. I want to
    see my late friends. I want this shitshow to end. I want to eat some actual snacks."
  questReference: {fileID: 0}
  isQuestCompletionTrigger: 0
  isQuestUnlockTrigger: 0
