  m_Script: {fileID: 11500000, guid: 6df2383365654c646b5c188598b26e99, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueCanvas: {fileID: 1424131237}
  dialogueText: {fileID: 1517627327}
  dialogueLines:
  - "INTERN: Everyday they make us come up with a new spot to cover up company\u2019s
    another image crisis."
  - "INTERN: Every. Single. Day. I\u2019m just a PR intern, I should be\u2026 I don\u2019t
    know. Sweeping the floor. Making coffee."
  - "INTERN: I\u2019m starting to suspect the multi-billion company I work at for
    minimum wage is morally dubious."
  - 'INTERN: Their choco bars lowkey fire, though.'
  questReference: {fileID: 0}
  isQuestCompletionTrigger: 0
  isQuestUnlockTrigger: 0
