--- !u!114 &776635861
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 776635859}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6df2383365654c646b5c188598b26e99, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueCanvas: {fileID: 446587662}
  dialogueText: {fileID: 1779194758}
  dialogueLines:
  - "WORKER: I feel like I\u2019m roleplaying an accountant, dude. I type numbers
    that don\u2019t mean anything. Just\u2026 Fill in sheets day and night, over
    and over. Like a human cash register."
  - "WORKER: \u2026What? Oh, no, no. I can\u2019t make them up and type anything.
    Are you crazy?"
  - 'WORKER: They do carry meaning. Just not one I get. Actually, once in a while
    I put in something wrong. Then, a manager yells at me and I have to start anew.'
  - "WORKER: I can\u2019t believe I ignored parties in college just to get hired
    here."
  questReference: {fileID: 0}
  isQuestCompletionTrigger: 0
  isQuestUnlockTrigger: 0
