  dialogueText: {fileID: 1531313399}
  dialogueLines:
  - "BOSS: And then Lisa said she won\u2019t\u2026 Wait a second.\r\n"
  - "BOSS: What? You say I should check my phone? Huh?\r"
  - "BOSS: Who\u2019s Agile_Not_Only_At_Work_1992? And why did they send me a picture
    with a title that says\u2013\r\r\n"
  - "BOSS: Oh. Oh. Excuse me, guys. I think I should make a\u2026 A call. Super important
    business matter.\r\r\r\n"
